rules_version = '2';

// Watch-party documents. See docs/AGENT_ARCHITECTURE.md ("Watch party") for the data model.
//  - Anyone signed in (including anonymous guests) can read a party.
//  - Only a real (non-anonymous) account can create one, and only as its own host.
//  - The host alone can change `candidates`, `status` and `winnerId`.
//  - A member can only write members.<their uid> and votes.<their uid>; votes must be 1 or -1.
//  - Nothing can be written once the party is locked or expired.
service cloud.firestore {
  match /databases/{database}/documents {

    match /parties/{partyId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['hostUid', 'name', 'createdAt', 'expiresAt', 'status', 'constraints', 'members', 'candidates', 'votes', 'winnerId'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && request.resource.data.status == 'voting'
        && request.resource.data.winnerId == null
        && request.resource.data.votes.size() == 0
        && request.resource.data.candidates is list
        && request.resource.data.candidates.size() <= 8
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt <= request.time.toMillis() + 60000
        && request.resource.data.createdAt >= request.time.toMillis() - 60000
        && request.resource.data.expiresAt == request.resource.data.createdAt + 172800000;

      allow update: if request.auth != null
        && resource.data.status == 'voting'
        && request.time.toMillis() < resource.data.expiresAt
        && (hostChange() || memberChange());

      allow delete: if false;

      // Host: candidates / status / winnerId only. Everything else stays as it was.
      function hostChange() {
        return request.auth.uid == resource.data.hostUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['candidates', 'status', 'winnerId'])
          && request.resource.data.candidates is list
          && request.resource.data.candidates.size() <= 8
          && request.resource.data.status in ['voting', 'locked']
          && (request.resource.data.winnerId == null || request.resource.data.winnerId is int);
      }

      // Anyone signed in: only their own members.<uid> and votes.<uid> entries.
      function memberChange() {
        let d = request.resource.data.diff(resource.data);
        let uid = request.auth.uid;
        return d.affectedKeys().hasOnly(['members', 'votes'])
          && (!d.affectedKeys().hasAny(['members'])
              || (request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([uid])
                  && validMember(request.resource.data.members, uid)))
          && (!d.affectedKeys().hasAny(['votes'])
              || (request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([uid])
                  && uid in request.resource.data.members
                  && validVotes(request.resource.data.votes, uid)));
      }

      function validMember(members, uid) {
        return members[uid].keys().hasOnly(['displayName', 'joinedAt'])
          && members[uid].displayName is string
          && members[uid].displayName.size() > 0
          && members[uid].displayName.size() <= 30
          && members[uid].joinedAt is int;
      }

      function validVotes(votes, uid) {
        return !(uid in votes)
          || (votes[uid].size() <= 8 && votes[uid].values().hasOnly([1, -1]));
      }
    }
  }
}
